---
import Shell from '../components/Shell.astro';
import ru from '../content/ru.json';
export const prerender = false; // so /watch can rewrite to it at runtime
const t = ru.notFound;
Astro.response.status = 404;
---
<Shell lang="ru" title={t.title} noindex>
  <h1>{t.title}</h1>
  <p class="lead">{t.lead}</p>
  <p class="links"><a href="/">{t.home}</a><a href="/access">{t.access}</a></p>
</Shell>
<style>
  h1 { font-size: clamp(32px, 5vw, 48px); line-height: 1.1; }
  .lead { margin-top: 12px; color: var(--muted); }
  .links { margin-top: 24px; display: flex; gap: 24px; }
</style>
