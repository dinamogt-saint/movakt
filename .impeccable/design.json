  "narrative": {
    "northStar": "Молоко",
    "overview": "A milk-white page, warm and nearly silent. The system holds back almost all colour so the photographs of Katerina and her students carry it; everything else is ink on warm off-white, separated by hairline rules. It reads like a well-set printed programme: a ledger of sections, each with a small spaced-caps label on the left and plain content on the right.\n\nDensity is low and the rhythm generous. Structure comes from 1px lines, not boxes, shadows or tints. The single filled surface below the photos is the price card, a sand-toned block that marks the one place where a decision is made. Corners are square throughout, and the type is one family, Onest, in three weights.",
    "keyCharacteristics": [
      "Colour lives only in photographs; UI is ink, warm ground and hairlines.",
      "Sections as a ruled ledger: label column (3fr) beside content (9fr) on desktop.",
      "Lists are drawn as ruled rows, not bullets or cards.",
      "Square corners, 1px lines, no shadows.",
      "One filled surface (the price card) besides photo frames."
    ],
    "rules": [
      {
        "name": "The Milk Rule",
        "body": "The interface carries no hue. If a screen needs colour, it comes from a photograph, never from a tinted panel, badge, gradient or coloured text.",
        "section": "colors"
      },
      {
        "name": "The One Sand Block Rule",
        "body": "Sand fills photo frames and the price card. No other content block gets a background.",
        "section": "colors"
      },
      {
        "name": "The One Family Rule",
        "body": "Onest only. No second display face, no serif accents, no mono.",
        "section": "typography"
      },
      {
        "name": "The Tabular Minutes Rule",
        "body": "Prices, minutes and lesson numbers set in tabular figures so ruled rows align.",
        "section": "typography"
      },
      {
        "name": "The Hairline Rule",
        "body": "Separation is a 1px line in the hairline colour. Never a shadow, never a gap with a tinted band.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** keep the interface to ink, milk, sand and hairlines; let photographs bring the colour.",
      "**Do** separate everything with 1px hairline rules; use the on-sand hairline inside the price card.",
      "**Do** draw lists as ruled rows with tabular figures on the right.",
      "**Do** use the solid ink button for every purchase action and route it to the one payment dialog.",
      "**Do** keep corners square and icons built from 1px bars."
    ],
    "donts": [
      "**Don't** add a hue to UI: no coloured panels, pills, badges or gradients.",
      "**Don't** use shadows or rounded corners.",
      "**Don't** give content blocks a background other than the price card's sand.",
      "**Don't** introduce a second typeface.",
      "**Don't** put a small uppercase line above a heading; the uppercase label belongs only in the ledger column as the section heading itself."
    ]
  }
